{
  "expo": {
    "name": "rosters-mobile",
    "slug": "rosters-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roster.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": ["group.com.roster.app.onesignal"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.roster.app",
      "statusBar": {
        "backgroundColor": "#000000",
        "barStyle": "light-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "smallIcons": ["./assets/notification/ic_stat_onesignal_default.png"],
          "largeIcons": ["./assets/notification/ic_onesignal_large_icon_default.png"],
          "smallIconAccentColor": "#3c83f6"
        }
      ]
    ],
    "extra": {
      "oneSignalAppId": "c73c3e8e-8121-4cb6-8979-a09427b5523c"
    }
  }
}
